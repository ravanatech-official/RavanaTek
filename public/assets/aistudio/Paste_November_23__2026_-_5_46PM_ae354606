            };

            const PRODUCTION_FIREBASE_HOSTS = new Set(["ravanatek.web.app", "ravanatek.firebaseapp.com"])
;

            // Prevent Firebase Installations / Analytics background promise rejections from crashing the
 UI
            window.addEventListener("unhandledrejection", (event) => {
              const reason = event.reason;
              const code = reason && reason.code ? String(reason.code) : "";
              const msg = reason && reason.message ? String(reason.message) : String(reason || "");
              if (code.startsWith("installations/") || msg.includes("installations/request-failed")) {
                event.preventDefault();
                console.warn("[RAVANA TECH] Firebase Analytics/Installations skipped (API key restricted 
or unavailable for this origin):", msg);
              }
            });

            // Lazy-Initialize Firebase & Firestore on user demand (Saves 35MB+ initial browser memory)
            let appInstance = null;
            let firestoreInstance = null;

            function getFirestoreInstance() {
              if (!firestoreInstance) {
                appInstance = initializeApp(firebaseConfig);
                if (PRODUCTION_FIREBASE_HOSTS.has(window.location.hostname)) {
                  isAnalyticsSupported()
                    .then((supported) => {
                      if (supported) {
                        window.firebaseAnalytics = getAnalytics(appInstance);
                      }
                    })
                    .catch(() => {});
                }
                firestoreInstance = getFirestore(appInstance);
                window.firebaseApp = appInstance;
                window.firebaseDb = firestoreInstance;
                console.log("[RAVANA TECH] Firebase & Firestore initialized on-demand // Project: ravanat
ek");
              }
              return firestoreInstance;
            }

            // Pre-warm Firestore on contact form focus/entry to ensure zero delay on submission
            const contactSection = document.getElementById('contact');
            if (contactSection && 'IntersectionObserver' in window) {
              const contactObserver = new IntersectionObserver((entries) => {
                if (entries[0] && entries[0].isIntersecting) {
                  getFirestoreInstance();
                  contactObserver.disconnect();
                }
              }, { threshold: 0.1 });
              contactObserver.observe(contactSection);
            }

            window.saveInquiryToFirestore = async function(inquiryData) {
              try {
                const db = getFirestoreInstance();
                const docRef = await addDoc(collection(db, "inquiries"), {
                  name: inquiryData.name,
                  email: inquiryData.email,
                  system: inquiryData.system,
                  message: inquiryData.message,
                  createdAt: serverTimestamp(),
                  clientTimestamp: new Date().toISOString(),
                  source: "website_command_console",
                  status: "new"
                });
                console.log("[RAVANA TECH] Transmission recorded to Firestore with ID:", docRef.id);
                return { success: true, id: docRef.id };
              } catch (firestoreErr) {
                console.warn("[RAVANA TECH] Firestore persistence deferred / fallback:", firestoreErr);
                return { success: false, error: firestoreErr };
              }
            };
