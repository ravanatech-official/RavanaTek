rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // MULTI-SITE SAFETY NOTICE:
    // If another site in project `ravanatek` shares the `(default)` Firestore
    // database (RaOne-AI uses its own named DB `ai-studio-raoneai-...`), merge
    // that site's collection rules here BEFORE running `deploy --only firestore:rules`.
    // =========================================================================

    // Inquiries / Leads Collection (Ravana Tech):
    // Strict field allowlist, email format validation, size limits, server timestamp,
    // and zero public read/update/delete.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
                        'name', 'email', 'system', 'message',
                        'createdAt', 'clientTimestamp', 'source', 'status'
                    ])
                    && request.resource.data.keys().hasAll([
                        'name', 'email', 'message', 'createdAt', 'status'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && (!('system' in request.resource.data)
                        || (request.resource.data.system is string && request.resource.data.system.size() < 200))
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 1
                    && request.resource.data.message.size() < 5000
                    && (!('source' in request.resource.data)
                        || (request.resource.data.source is string && request.resource.data.source.size() <= 100))
                    && (!('clientTimestamp' in request.resource.data)
                        || (request.resource.data.clientTimestamp is string && request.resource.data.clientTimestamp.size() <= 64))
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Default-deny catch-all for all unconfigured paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
